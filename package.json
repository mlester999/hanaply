{
  "name": "hanaply",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=11.10.0 <12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "clean": "node tooling/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --config tooling/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config tooling/vitest.config.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --level error",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/database/src/generated.types.ts",
    "db:types:check": "node tooling/check-database-types.mjs",
    "e2e": "playwright test --config tooling/playwright.config.ts",
    "openapi:check": "node tooling/check-openapi.mjs",
    "secrets:check": "node tooling/secret-scan.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm openapi:check && pnpm secrets:check",
    "validate:local": "pnpm validate && pnpm db:reset && pnpm db:lint && pnpm db:test && pnpm db:types:check && pnpm e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.2.11",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "tsup": "8.5.1",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
