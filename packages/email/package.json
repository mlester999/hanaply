{
  "name": "@hanaply/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts --format esm --dts --sourcemap --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hanaply/config": "workspace:*",
    "resend": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
