{
  "name": "@hanaply/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "import": "./dist/prompt.js"
    },
    "./grounding": {
      "types": "./dist/grounding.d.ts",
      "import": "./dist/grounding.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "import": "./dist/tasks.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "import": "./dist/fake.js"
    },
    "./openai-compatible": {
      "types": "./dist/openai-compatible.d.ts",
      "import": "./dist/openai-compatible.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/types.ts src/prompt.ts src/grounding.ts src/tasks.ts src/fake.ts src/openai-compatible.ts --format esm --dts --sourcemap --clean --external @hanaply/config --external @hanaply/matching",
    "dev": "tsup src/index.ts src/types.ts src/prompt.ts src/grounding.ts src/tasks.ts src/fake.ts src/openai-compatible.ts --format esm --dts --sourcemap --watch --external @hanaply/config --external @hanaply/matching",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hanaply/config": "workspace:*",
    "@hanaply/matching": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}
