{
  "name": "@hanaply/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --sourcemap --clean --platform node",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hanaply/config": "workspace:*",
    "@hanaply/contracts": "workspace:*",
    "@hanaply/database": "workspace:*",
    "@hanaply/email": "workspace:*",
    "@hanaply/observability": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "fastify": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  }
}
