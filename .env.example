# Copy this file to .env.local. Never commit .env.local.
NODE_ENV=development
HANAPLY_ENV=local
LOG_LEVEL=debug

APP_BASE_URL=http://localhost:3100
API_BASE_URL=http://localhost:3101
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:3101
AUTH_RATE_LIMIT_PEPPER=replace-with-at-least-32-random-characters-in-production

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres
SUPABASE_PROJECT_REF=local

API_PORT=3101
WORKER_HEALTH_PORT=3102
WORKER_MODE=idle
WORKER_POLL_INTERVAL_MS=5000
WORKER_MAINTENANCE_INTERVAL_MS=300000
WORKER_NOTIFICATION_BATCH_SIZE=25
WORKER_NOTIFICATION_MAX_ATTEMPTS=5
WORKER_STORAGE_CLEANUP_BATCH_SIZE=25
WORKER_STORAGE_CLEANUP_MAX_ATTEMPTS=5
SUBSCRIPTION_EXPIRY_REMINDER_DAYS=30,7,1

# Job intelligence worker. Ingestion is shared infrastructure: one scan per
# source serves every subscriber, and plan cadence only decides how often the
# shared scan runs. Credential-backed providers read the environment variable
# named in public.job_sources.credential_env_var; the secret value is never
# stored in the database. Leave them unset to keep those providers unavailable,
# which is the default because every catalogued provider starts paused.
JOB_INGESTION_USER_AGENT=HanaplyBot/1.0 (+https://hanaply.com/bot)
JOB_INGESTION_TIMEOUT_MS=15000
JOB_STALE_AFTER_HOURS=168
JOB_EXPIRE_AFTER_HOURS=720
MATCHING_BATCH_SIZE=25
MATCHING_CANDIDATE_LIMIT=60
MATCHING_STALE_AFTER_HOURS=12
# Opportunity notification delivery. Consent and entitlement are both required
# before anything is queued: the queueing functions only create an outbox row
# when the subscriber turned the category on in notification settings *and*
# their evaluated plan includes the matching entitlement (job alerts, daily
# digest, weekly strategy). These settings can therefore only narrow what an
# already-consented subscriber receives; they can never start a new send.
# JOB_ALERT_WINDOW_MINUTES bounds how often one subscriber can be alerted
# (window start is part of the idempotency key, so a repeated pass queues
# nothing new). The digests are queued at most once per maintenance interval.
JOB_ALERT_WINDOW_MINUTES=30
JOB_ALERT_MINIMUM_SCORE=75
DIGEST_MINIMUM_SCORE=55
NOTIFICATION_BATCH_SIZE=25
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# JOOBLE_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3100
RATE_LIMIT_STORE=memory
# Rate limits, per scope. The bucket is the verified member for an authenticated
# route and the client address for an anonymous one, so the old shared "global"
# bucket — every member behind the web server spending one allowance — is gone.
# See docs/security.md and services/api/src/rate-limit.ts.
#   AUTHENTICATED  per member, on a route that requires a session (100 a minute)
#   ANONYMOUS      per address, for a caller with no usable session (60 a minute)
#   SENSITIVE      per address and submitted identifier, for an authentication
#                  route that takes one (10 per 15 minutes)
#   EXPENSIVE      per member, a second ceiling on model and generation routes
#                  (60 a minute)
RATE_LIMIT_AUTHENTICATED_LIMIT=100
RATE_LIMIT_AUTHENTICATED_TTL_MS=60000
RATE_LIMIT_ANONYMOUS_LIMIT=60
RATE_LIMIT_ANONYMOUS_TTL_MS=60000
RATE_LIMIT_SENSITIVE_LIMIT=10
RATE_LIMIT_SENSITIVE_TTL_MS=900000
RATE_LIMIT_EXPENSIVE_LIMIT=60
RATE_LIMIT_EXPENSIVE_TTL_MS=60000
OPENAPI_ENABLED=true
BUILD_SHA=local

PAYMENT_PROOF_BUCKET=payment-proofs
PAYMENT_QR_BUCKET=payment-qr-codes
PAYMENT_PROOF_MAX_BYTES=8388608
PAYMENT_QR_MAX_BYTES=5242880
PAYMENT_IMAGE_MAX_PIXELS=40000000
PAYMENT_SIGNED_URL_TTL_SECONDS=300
STORAGE_CLEANUP_MODE=immediate

EMAIL_PROVIDER=capture
EMAIL_ALLOW_LIVE_SENDS=false
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_REPLY_TO_ADDRESS=
RESEND_REQUEST_TIMEOUT_MS=8000

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=

# AI generation. `disabled` is the default and means what it says: no model is
# called, the deterministic engine in packages/matching and services/api remains
# the product, and nothing labels its output as model-written. Selecting a
# provider without a credential is not a state production accepts, because a
# silently absent key would present deterministic text as though a model wrote
# it. `fake` is deterministic and selectable only in local and test. One
# OpenAI-compatible contract covers every provider, so AI_BASE_URL is the only
# vendor-specific setting and defaults per provider:
#   openai https://api.openai.com/v1          groq     https://api.groq.com/openai/v1
#   openrouter https://openrouter.ai/api/v1   deepseek https://api.deepseek.com/v1
#   together https://api.together.xyz/v1      ollama   http://127.0.0.1:11434/v1
#   vllm http://127.0.0.1:8000/v1             azure_openai  requires the full endpoint
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1600
AI_MAX_INPUT_CHARACTERS=60000
AI_TEMPERATURE=0.2
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=250
# auto uses a JSON schema when the deployment enforces one and falls back to a
# strict parse-and-repair path when it does not.
AI_STRUCTURED_OUTPUT=auto
