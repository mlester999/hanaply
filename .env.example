# Copy this file to .env.local. Never commit .env.local.
NODE_ENV=development
HANAPLY_ENV=local
LOG_LEVEL=debug

APP_BASE_URL=http://localhost:3100
API_BASE_URL=http://localhost:3101
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:3101
AUTH_RATE_LIMIT_PEPPER=replace-with-at-least-32-random-characters-in-production

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres
SUPABASE_PROJECT_REF=local

API_PORT=3101
WORKER_HEALTH_PORT=3102
WORKER_MODE=idle
WORKER_POLL_INTERVAL_MS=5000
WORKER_MAINTENANCE_INTERVAL_MS=300000
WORKER_NOTIFICATION_BATCH_SIZE=25
WORKER_NOTIFICATION_MAX_ATTEMPTS=5
WORKER_STORAGE_CLEANUP_BATCH_SIZE=25
WORKER_STORAGE_CLEANUP_MAX_ATTEMPTS=5
SUBSCRIPTION_EXPIRY_REMINDER_DAYS=30,7,1

# Job intelligence worker. Ingestion is shared infrastructure: one scan per
# source serves every subscriber, and plan cadence only decides how often the
# shared scan runs. Credential-backed providers read the environment variable
# named in public.job_sources.credential_env_var; the secret value is never
# stored in the database. Leave them unset to keep those providers unavailable,
# which is the default because every catalogued provider starts paused.
JOB_INGESTION_USER_AGENT=HanaplyBot/1.0 (+https://hanaply.com/bot)
JOB_INGESTION_TIMEOUT_MS=15000
JOB_STALE_AFTER_HOURS=168
JOB_EXPIRE_AFTER_HOURS=720
MATCHING_BATCH_SIZE=25
MATCHING_CANDIDATE_LIMIT=60
MATCHING_STALE_AFTER_HOURS=12
# Opportunity notification delivery. Consent and entitlement are both required
# before anything is queued: the queueing functions only create an outbox row
# when the subscriber turned the category on in notification settings *and*
# their evaluated plan includes the matching entitlement (job alerts, daily
# digest, weekly strategy). These settings can therefore only narrow what an
# already-consented subscriber receives; they can never start a new send.
# JOB_ALERT_WINDOW_MINUTES bounds how often one subscriber can be alerted
# (window start is part of the idempotency key, so a repeated pass queues
# nothing new). The digests are queued at most once per maintenance interval.
JOB_ALERT_WINDOW_MINUTES=30
JOB_ALERT_MINIMUM_SCORE=75
DIGEST_MINIMUM_SCORE=55
NOTIFICATION_BATCH_SIZE=25
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# JOOBLE_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3100
RATE_LIMIT_STORE=memory
OPENAPI_ENABLED=true
BUILD_SHA=local

PAYMENT_PROOF_BUCKET=payment-proofs
PAYMENT_QR_BUCKET=payment-qr-codes
PAYMENT_PROOF_MAX_BYTES=8388608
PAYMENT_QR_MAX_BYTES=5242880
PAYMENT_IMAGE_MAX_PIXELS=40000000
PAYMENT_SIGNED_URL_TTL_SECONDS=300
STORAGE_CLEANUP_MODE=immediate

EMAIL_PROVIDER=capture
EMAIL_ALLOW_LIVE_SENDS=false
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_REPLY_TO_ADDRESS=
RESEND_REQUEST_TIMEOUT_MS=8000

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
